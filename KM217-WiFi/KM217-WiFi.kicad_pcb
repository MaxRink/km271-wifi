	(gr_text "FAB NOTES ${TITLE} rev ${REVISION}\nStackup: 2 layers, FR4 TG135, 1.6 mm +-10 pct, outer copper 1 oz (35 um)\nL1 F.Cu signal/GND pour | core 1.5 mm | L2 B.Cu signal/GND pour\nFinish: ENIG (gold fingers). Gold fingers: YES, bevel: NO (see J1 note)\nMask green, silk white, vias tented. Min track/space 0.20/0.20 mm, min via 0.3/0.6 mm\nAssembly: Standard PCBA, both sides. BOM/CPL: production/bom.csv, production/positions.csv"
		(at 69.95 140.05 0)
		(layer "Cmts.User")
		(uuid "af3296aa-10e8-49f4-9ec5-96e17a40574f")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.12)
			)
			(justify left)
		)
	)
	(gr_text "FAB NOTE J1 (KM271 card edge): 12 gold fingers F+B, 1.6 mm FR4 (+-10%).\nOrder option: Gold Fingers = YES (ENIG / hard gold on fingers), mask open over fingers.\nBevel: NOT POSSIBLE - finger edge (y=124.25) is recessed 5.75 mm between the board legs\n(y=130) and JLC chamfers only boards >= 50x50 mm. Original module is used unbevelled.\nFingers end 0.2 mm before the board edge; no vias/pads within 1 mm (rule area GOLD_FINGERS)."
		(at 70 134 0)
		(layer "Cmts.User")
		(uuid "5273c289-4ed7-4062-9a61-2490577d8652")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.12)
			)
			(justify left)
		)
	)
