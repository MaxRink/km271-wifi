(version 1)
# JLCPCB 2-layer, 1 oz, 1.6 mm FR4 rules (jlcpcb.com/capabilities/pcb-capabilities, fetched 2026-10-25)

(rule "JLC min track width 0.10"
	(constraint track_width (min 0.1mm)))

(rule "JLC copper clearance 0.10"
	(constraint clearance (min 0.1mm)))

(rule "JLC SMD pad to pad (different nets) 0.15"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD' && A.Net != B.Net")
	(constraint clearance (min 0.15mm)))

(rule "JLC via: hole 0.2 / diameter 0.45 (no extra cost)"
	(condition "A.Type == 'Via'")
	(constraint hole_size (min 0.2mm))
	(constraint via_diameter (min 0.45mm)))

(rule "JLC PTH annular ring 0.18 (2-layer absolute min)"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint annular_width (min 0.18mm)))

(rule "JLC min drill 0.15 / NPTH 0.5"
	(constraint hole_size (min 0.15mm)))
(rule "JLC NPTH min 0.5"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
	(constraint hole_size (min 0.5mm)))

(rule "JLC pad hole to hole 0.45"
	(constraint hole_to_hole (min 0.45mm)))
(rule "JLC via hole to hole 0.20"
	(condition "A.Type == 'Via' && B.Type == 'Via'")
	(constraint hole_to_hole (min 0.2mm)))

(rule "JLC via/NPTH hole to track 0.20"
	(constraint hole_clearance (min 0.2mm)))
(rule "JLC PTH to track 0.28"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Type == 'Track'")
	(constraint hole_clearance (min 0.28mm)))

(rule "JLC copper to routed edge 0.20"
	(constraint edge_clearance (min 0.2mm)))

(rule "JLC legend: min text height 1.0, line width 0.15"
	(condition "A.Layer == 'F.SilkS' || A.Layer == 'B.SilkS'")
	(constraint text_height (min 1.0mm))
	(constraint text_thickness (min 0.15mm)))

(rule "JLC pad to silkscreen 0.15"
	(condition "A.Type == 'Pad' || B.Type == 'Pad'")
	(constraint silk_clearance (min 0.15mm)))

(rule "JLC gold fingers: no vias/pour/other pads within 1 mm"
	(condition "A.Type != 'Zone' && A.intersectsArea('GOLD_FINGERS') && A.Type != 'Track' && !(A.Type == 'Pad' && A.Parent.Reference == 'J1')")
	(constraint disallow via pad))

(rule "Best practice: copper pours pulled back 0.5 mm from routed edges"
	(condition "A.Type == 'Zone' && !A.intersectsArea('GOLD_FINGERS')")
	(constraint edge_clearance (min 0.5mm)))
